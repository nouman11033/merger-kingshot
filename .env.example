# ---------------------------------------------------------------------------
# Kingshot Stats API — SERVER ONLY.
# Never prefix this with NEXT_PUBLIC_; it must never reach the browser.
# Create a key at https://api.kingshotstats.com (sign in with Discord).
# ---------------------------------------------------------------------------
KINGSHOT_API_KEY=kss_your_key_here

# Optional. Defaults to https://api.kingshotstats.com/v1
# KINGSHOT_API_BASE_URL=https://api.kingshotstats.com/v1

# ---------------------------------------------------------------------------
# Supabase — the source of truth for rosters and Prime selections.
# Project Settings > API in the Supabase dashboard.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# SERVER ONLY. Used to write rosters and clear selections. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
